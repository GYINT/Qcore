{
  "dashboard": {
    "title": "Infoseek MCP 跨设备审计监控（V0.7.0）",
    "uid": "infoseek-audit-070",
    "version": 1,
    "schemaVersion": 39,
    "refresh": "30s",
    "time": { "from": "now-24h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "在线时长",
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "infoseek_uptime_seconds",
            "legendFormat": "uptime",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": { "mode": "thresholds" }
          }
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "工具调用总量",
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
        "targets": [
          {
            "expr": "sum(infoseek_tool_calls_total)",
            "legendFormat": "total",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "type": "stat",
        "title": "审计记录（成功）",
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
        "targets": [
          {
            "expr": "infoseek_audit_total{status=\"200\"}",
            "legendFormat": "200",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "type": "stat",
        "title": "审计记录（错误）",
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "sum(infoseek_audit_total{status=~\"4..|5..\"})",
            "legendFormat": "4xx+5xx",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "type": "bargauge",
        "title": "按工具调用量",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [
          {
            "expr": "topk(10, infoseek_tool_calls_total)",
            "legendFormat": "{{tool}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "palette-classic" }
          }
        }
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "审计状态码趋势",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [
          {
            "expr": "rate(infoseek_audit_total[5m])",
            "legendFormat": "status {{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": { "mode": "palette-classic" }
          }
        }
      },
      {
        "id": 7,
        "type": "timeseries",
        "title": "工具调用速率",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
        "targets": [
          {
            "expr": "sum by (tool) (rate(infoseek_tool_calls_total[5m]))",
            "legendFormat": "{{tool}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": { "mode": "palette-classic" }
          }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "query": "prometheus",
          "label": "Prometheus",
          "current": { "value": "prometheus", "text": "Prometheus" }
        }
      ]
    },
    "annotations": {
      "list": []
    },
    "editable": true,
    "tags": ["infoseek", "mcp", "audit"]
  }
}
